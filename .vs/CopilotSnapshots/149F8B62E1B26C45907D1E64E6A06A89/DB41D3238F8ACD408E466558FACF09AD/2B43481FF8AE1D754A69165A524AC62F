using System;
namespace university_Project
{
    public class Visitor : User
    {
        public Visitor(string name) : base(name, "Visitor") { }
        public override void ShowMenu()
        {
            bool exit = false;
            while (!exit)
            {
                Console.WriteLine("\nVisitor Menu:");
                Console.WriteLine("1) View Courses");
                Console.WriteLine("2) View Results");
                Console.WriteLine("3) Logout");
                Console.Write("Select option: ");
                try
                {
                    int option = int.Parse(Console.ReadLine());
                    switch (option)
                    {
                        case 1:
                            Console.WriteLine("Course list (demo logic).");
                            break;
                        case 2:
                            Console.WriteLine("Results (demo logic).");
                            break;
                        case 3:
                            exit = true;
                            break;
                        default:
                            Console.WriteLine("Invalid option.");
                            break;
                    }
                }
                catch
                {
                    Console.WriteLine("Please enter a valid number.");
                }
            }
        }
    }
}
